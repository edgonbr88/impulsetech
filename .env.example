# ========================================================
# IMPULSETECH — VARIABLES DE ENTORNO LOCAL
# ========================================================

# Base de datos PostgreSQL
POSTGRES_USER=impulsetech
POSTGRES_PASSWORD=impulsetech_secure_pass_2026
POSTGRES_DB=impulsetech_dev
POSTGRES_PORT=5433

# URLs de conexión para dbmate y backend
# Usar esta URL dentro de Docker (red interna)
DATABASE_URL=postgresql://impulsetech:impulsetech_secure_pass_2026@postgres:5432/impulsetech_dev?sslmode=disable
# Usar esta URL desde la máquina host
DATABASE_URL_LOCAL=postgresql://impulsetech:impulsetech_secure_pass_2026@localhost:5433/impulsetech_dev?sslmode=disable

# Configuración Backend FastAPI
BACKEND_PORT=8000
ENVIRONMENT=development
JWT_SECRET_KEY=impulsetech_super_secret_jwt_key_2026_dev_environment_at_least_32_bytes_long
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Configuración Frontend Angular
FRONTEND_PORT=4200
API_BASE_URL=http://localhost:8000/api/v1
